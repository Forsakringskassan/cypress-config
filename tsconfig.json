{
    "$schema": "https://www.schemastore.org/tsconfig",
    "extends": [
        "@tsconfig/recommended",
        "@tsconfig/node22",
        "@tsconfig/strictest"
    ],
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "dist",
        "emitDeclarationOnly": true,
        "declaration": true,
        "declarationDir": "temp/types",
        "declarationMap": true,
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
            "@forsakringskassan/cypress-config/support": [
                "./src/support/index.ts"
            ],
            "@forsakringskassan/cypress-config": ["./src/index.ts"]
        }
    },
    "include": ["**/*.ts", "**/*.mts"],
    "exclude": ["dist/**", "node_modules/**", "temp/**"]
}
